#==============================================================================================
#
#   vector - Vector shapes drawn into tiles only where they reach
#
#   DESCRIPTION:
#       Vector layers as Photoshop's shape layers and paths are: elements (a ShapeSpec each)
#       drawn into luce-canvas tiles through luce-svg, cell by cell: a cell an outline crosses
#       is drawn, a cell wholly inside one fill shares one tile, and an edit draws only the
#       cells its element covered or covers. Also the elements' files and SVG import.
#       Fragments, in ORDER:
#
#       module.lucb      imports
#       shapes.lucb      ShapeSpec, its values, and its SVG text
#       paths.lucb       Bézier paths drawn with the Pen
#       elements.lucb    a layer's list of elements
#       cells.lucb       which cells of a shape need drawing; CellMask for edits
#       bins.lucb        elements sorted into bins so a window parses only its own
#       windows.lucb     edge cells drawn a window at a time on the worker pool
#       render.lucb      a layer's elements drawn into its tiles
#       geometry.lucb    hit testing
#       files.lucb       elements in a Prism manifest
#       svg_import.lucb  an SVG's shapes as elements
#
#==============================================================================================

import c as c_api
from luce_std import files
from luce_gpu import gpu
import interop
from luce_std import math
import memory
import os
from luce_canvas import pool
from luce_prism import prism
import strings
from luce_svg import svg
from luce_color import transfer
from luce_canvas.tiles import Tiles, tile_size, tile_columns, min_u32, max_u32
from luce_canvas.half import to_half, from_half
from luce_raster.errors import invalid, limit
